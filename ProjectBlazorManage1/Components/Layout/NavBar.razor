@using Microsoft.AspNetCore.Components.Authorization

<!-- Enhanced Golden Navbar -->
<nav class="navbar navbar-expand-lg golden-navbar">
    <div class="container">
        <a class="navbar-brand" href="">
            <div class="logo-container">
                <img src="/cs67/blazor/s14/ProjectBlazorMN/images/Logo.png" alt="Logo" class="logo-img">

                <div class="logo-glow"></div>
            </div>
            <div class="brand-text">
                <span class="brand-title">สถาบันพลังจิตตานุภาพ</span>
                <span class="brand-subtitle">สาขาที่ 58 วัดสิริกาญจนาราม</span>
            </div>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
                aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
            <i class="bi bi-list"></i>
        </button>

        <div class="collapse navbar-collapse" id="navbarMain">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                        <i class="bi bi-house-door"></i> หน้าแรก
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="NewsPage">
                        <i class="bi bi-newspaper"></i> ข่าวสาร
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="personnel-list">
                        <i class="bi bi-people"></i> บุคลากร
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link" href="about">
                        <i class="bi bi-info-circle"></i> เกี่ยวกับสถาบัน
                    </NavLink>
                </li>
                <li class="nav-item">
                    <AuthorizeView>
                        <Authorized>
                            <form action="Account/Logout" method="post" class="d-inline">
                                <AntiforgeryToken />
                                <input type="hidden" name="ReturnUrl" value="" />
                                <button type="submit" class="nav-link login-btn ms-lg-2">
                                    <i class="bi bi-box-arrow-right me-1"></i> ออกจากระบบ
                                </button>
                            </form>
                        </Authorized>
                        <NotAuthorized>
                            <NavLink class="nav-link login-btn ms-lg-2" href="Account/Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> เข้าสู่ระบบ
                            </NavLink>
                        </NotAuthorized>
                    </AuthorizeView>
                </li>
            </ul>
        </div>
    </div>
</nav>
