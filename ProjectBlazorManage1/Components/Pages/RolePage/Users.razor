@page "/users"
@using Microsoft.AspNetCore.Authorization
@inject RoleManager<IdentityRole> RoleManager
@inject NavigationManager NavigationManager
@inject UserService UserService
@inject IJSRuntime JSRuntime
@* @attribute [Authorize(Roles = "Admin")] *@

@if (IsProcessing)
{
	<div class="position-absolute w-75 h-75 d-flex flex-column align-items-center bg-white justify-content-center">
		<div class="spinner">
			<div class="rect1"></div>
			<div class="rect2"></div>
			<div class="rect3"></div>
			<div class="rect4"></div>
			<div class="rect5"></div>
		</div>
	</div>
}
else
{
	<div class="card shadow border-0 mt-4">
		<div class="card-header bg-dark bg-gradient ml-0 py-3">
			<div class="row">
				<div class="col-12 text-center">
					<h2 class="text-white py-2">ระบบจัดการผู้ใช้</h2>
				</div>
			</div>
		</div>
		<div class="card-body p-4">
			<MudDataGrid T="UserRoleViewModel"
						 Items="@FilteredUserList"
						 SortMode="SortMode.Multiple"
						 Filterable="true"
						 Hover="true"
						 Elevation="2"
						 Dense="true"
						 Bordered="true"
						 Striped="true"
						 Class="custom-datagrid">
				<ToolBarContent>
					<MudText Typo="Typo.h6" Color="Color.Primary" Class="font-weight-bold">จัดการผู้ใช้</MudText>
					<MudSpacer />
									 <div style="display: flex; align-items: center; gap: 12px;">
					<MudTextField @bind-Value="searchString"
								  Placeholder="ค้นหา..."
								  Variant="Variant.Outlined"
								  Size="Size.Small"
								  Adornment="Adornment.Start"
								  AdornmentIcon="@Icons.Material.Filled.Search"
								  Class="mr-2"
								  Immediate="true"
								  DebounceInterval="3000"
								  Style="width: 300px; font-size: 0.875rem;"
								  Margin="Margin.Dense" />
								  </div>
				</ToolBarContent>
				
				<Columns>
					<PropertyColumn Property="x => x.UserName"
									Title="ชื่อผู้ใช้"
									Filterable="true"
									Sortable="true"
									CellStyle="font-size: 14px;" />
					<PropertyColumn Property="x => x.Email"
									Title="Email"
									Filterable="true"
									Sortable="true"
									CellStyle="font-size: 14px;" />
					<PropertyColumn Property="x => x.CurrentRoles"
									Title="บทบาทปัจจุบัน"
									Filterable="true"
									Sortable="true"
									CellStyle="font-size: 14px;" />
					<TemplateColumn Title="เลือกบทบาทใหม่"
									CellStyle="font-size: 14px;">
						<CellTemplate>
							<MudSelect T="string"
									   Value="@context.Item.SelectedRole"
									   ValueChanged="@(newValue => context.Item.SelectedRole = newValue)"
									   Variant="Variant.Outlined"
									   Dense="true">
								@foreach (var role in context.Item.Roles)
								{
									<MudSelectItem Value="@role">@role</MudSelectItem>
								}
							</MudSelect>
						</CellTemplate>
					</TemplateColumn>
					<TemplateColumn Title="การจัดการ"
									CellClass="action-column"
									Sortable="false">
						<CellTemplate>
							<MudStack Row="true" Spacing="2">
								<MudButton Variant="Variant.Outlined"
										   Color="Color.Primary"
										   Size="Size.Small"
										   StartIcon="@Icons.Material.Filled.Save"
										   OnClick="@(() => ChangeUserRole(context.Item.UserName, context.Item.SelectedRole))">
									เปลี่ยนบทบาท
								</MudButton>
							</MudStack>
						</CellTemplate>
					</TemplateColumn>
				</Columns>

				<PagerContent>
					<MudDataGridPager T="UserRoleViewModel" />
				</PagerContent>
			</MudDataGrid>
		</div>
	</div>
}

@code {
	private List<UserRoleViewModel> viewModel;
	private bool IsProcessing { get; set; } = true;

	private string searchString = string.Empty;
	private IEnumerable<UserRoleViewModel> FilteredUserList => viewModel
			.Where(x => string.IsNullOrWhiteSpace(searchString) ||
					x.UserName.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
					x.Email.Contains(searchString, StringComparison.OrdinalIgnoreCase))
					.OrderBy(p => p.UserName);

	protected override async Task OnInitializedAsync()
	{
		IsProcessing = true;
		viewModel = await UserService.GetAllUsersWithRolesAsync();
		IsProcessing = false;
	}

	private async Task ChangeUserRole(string userName, string newRole)
	{
		IsProcessing = true;
		var success = await UserService.ChangeUserRoleAsync(userName, newRole);
		if (success)
		{
			viewModel = await UserService.GetAllUsersWithRolesAsync();
			await JSRuntime.InvokeVoidAsync("showToastr", "success", "เปลีนนบทบาทสำเร็จ");
		}
		IsProcessing = false;
	}
}