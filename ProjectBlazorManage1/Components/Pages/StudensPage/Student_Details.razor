@page "/Student/Student_Details/{Id:int}"
@inject StudentService _StudentService
@inject NavigationManager NavigationManager

<div class="container-fluid py-4">
    @if (students == null)
    {
        <div class="d-flex justify-content-center py-5">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">กำลังโหลด...</span>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-secondary text-white d-flex align-items-center">
                <h2 class="fs-4 mb-0"><i class="bi bi-person-badge me-2"></i> ข้อมูลนักเรียน</h2>
                <a href="Student" class="btn btn-light btn-sm ms-auto">
                    <i class="bi bi-arrow-left me-1"></i> กลับ
                </a>
            </div>

            <div class="card-body">
                <div class="row mb-4">
                    <!-- รูปภาพ -->
                    <div class="col-lg-2 col-md-3 text-center mb-3">
                        <div class="avatar-container position-relative mx-auto shadow-sm" style="width: 150px; height: 150px;">
                            @if (!string.IsNullOrEmpty(students.Images))
                            {
                                var firstImage = GetImageUrl();
                                if (!string.IsNullOrEmpty(firstImage))
                                {
                                    <img src="@firstImage" class="rounded-circle w-100 h-100 object-fit-cover" alt="@students.FirstName" />
                                }
                            }
                            else
                            {
                                <div class="bg-light rounded-circle d-flex align-items-center justify-content-center text-muted" style="width: 100%; height: 100%; font-size: 3rem;">
                                    <i class="bi bi-person"></i>
                                </div>
                            }

                            @if (!string.IsNullOrEmpty(students.Images) && students.Images.Split(',').Length > 1)
                            {
                                <span class="position-absolute bottom-0 end-0 bg-primary text-white rounded-circle d-flex align-items-center justify-content-center" style="width: 24px; height: 24px; font-size: 12px;">
                                    +@(students.Images.Split(',').Length - 1)
                                </span>
                            }
                        </div>
                        <h5 class="mt-3">@students.FirstName @students.LastName</h5>
                        <h5 class="mt-3">@students.PersonalId</h5>
                    </div>

                    <!-- ข้อมูลทั่วไป -->
                    <div class="col-lg-10 col-md-9">
                        <div class="card bg-light border-0 shadow-sm">
                            <div class="card-body">
                                <h5 class="text-primary mb-3"><i class="bi bi-person-lines-fill me-2"></i>ข้อมูลทั่วไป</h5>
                                <div class="list-group list-group-flush">
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span class="text-muted">รหัสนักเรียน:</span>
                                        <span>@students.Id</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span class="text-muted">ชื่อ-นามสกุล:</span>
                                        <span>@students.FirstName @students.LastName</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span class="text-muted">เบอร์โทร:</span>
                                        <span>@students.Phone_Number</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span class="text-muted">ชื่อเล่น:</span>
                                        <span>@students.Nickname</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span class="text-muted">วันเกิด:</span>
                                        <span>@students.BirthDate?.ToString("dd/MM/yyyy")</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span class="text-muted">อายุ:</span>
                                        <span>@students.Age ปี</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span class="text-muted">อีเมล:</span>
                                        <span>@students.Email</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span class="text-muted">ไอดีไลน์:</span>
                                        <span>@students.LineId</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span class="text-muted">วุฒิการศึกษา:</span>
                                        <span>@students.degreeType</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span class="text-muted">ความสัมพันธ์:</span>
                                        <span>@students.relationshipType</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span class="text-muted">สถาบันการศึกษา:</span>
                                        <span>@students.Institution</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span class="text-muted">อาชีพปัจจุบัน:</span>
                                        <span>@students.Occupation</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span class="text-muted">สถานที่ทำงาน:</span>
                                        <span>@students.Workplace</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span class="text-muted">บุคคลใกล้ชิด:</span>
                                        <span>@students.ClosePersonName (@students.ClosePersonPhone)</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span class="text-muted">โรคประจำตัว:</span>
                                        <span>@students.MedicalCondition</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span class="text-muted">ผู้แนะนำ:</span>
                                        <span>@students.adviser</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span class="text-muted">หมายเหตุ:</span>
                                        <span>@students.Remarks</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span class="text-muted">รุ่นที่เรียน:</span>
                                        <span>@students.classStudied?.ClassName</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span class="text-muted">ที่อยู่ตามบัตร:</span>
                                        <span>@students.CitizenCardAddress</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span class="text-muted">ที่อยู่ติดต่อได้:</span>
                                        <span>@students.ContactAddress</span>
                                    </div>
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span class="text-muted">วันที่สมัคร:</span>
                                        <span>@students.ApplicationDate.ToString("dd/MM/yyyy")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div> <!-- End Row -->

            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    public Students students { get; set; }
    private string BaseUrl => NavigationManager.BaseUri.TrimEnd('/');

    private string activeTab = "personal";
    protected override async Task OnInitializedAsync()
    {
        await LoadStudent();
    }

    private async Task LoadStudent()
    {
        students = await _StudentService.GetStudentId(Id);
    }

    private string GetImageUrl()
    {

        var fileName = Path.GetFileName(students.Images);

        var imageUrl = $"{BaseUrl}/images/Students/{fileName}";

        return imageUrl;
    }
}
