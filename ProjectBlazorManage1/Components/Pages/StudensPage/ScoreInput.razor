@page "/scores/{ClassId:int?}"
@inject ApplicationDbContext _context
@inject IJSRuntime _JSRuntime
@inject NavigationManager NavigationManager

<div class="container py-4 bg-light">
    @if (IsProcessing)
    {
        <div class="d-flex flex-column justify-content-center align-items-center" style="height: 400px;">
            <div class="spinner-border text-primary mb-3" style="width: 4rem; height: 4rem;"></div>
            <p class="fs-5 text-primary">กำลังโหลดข้อมูล...</p>
        </div>
    }
    else
    {
        <div class="card shadow-sm rounded-4 mb-4">
            <div class="card-header bg-primary text-white text-center py-3">
                <h3 class="fw-bold mb-1">บันทึกการบ้าน (เดินจงกรม - นั่งสมาธิ)</h3>
                <div>รุ่นที่ @ClassId | หลักสูตรทฺวิปญฺญาสโม</div>
            </div>
            <div class="card-body p-3">
                <EditForm Model="@this" OnValidSubmit="SaveScores">
                    @if (Students.Count == 0)
                    {
                        <div class="alert alert-warning text-center fs-5">ไม่พบข้อมูลนักเรียนในรุ่นนี้</div>
                    }
                    else
                    {
                        <div class="table-responsive mb-4">
                            <table class="table table-striped table-bordered align-middle text-center">
                                <thead class="table-dark">
                                    <tr>
                                        <th>รหัส</th>
                                        <th>ชื่อ</th>
                                        @foreach (var month in Months)
                                        {
                                            <th>@month</th>
                                        }
                                        <th>รวม</th>
                                        <th>รวม(ช.ม)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var student in Students)
                                    {
                                        <tr>
                                            <td>@student.PersonalId</td>
                                            <td class="text-start">@student.FirstName @student.LastName</td>
                                            <td><InputNumber @bind-Value="student.month1" class="form-control form-control-sm text-center" /></td>
                                            <td><InputNumber @bind-Value="student.month2" class="form-control form-control-sm text-center" /></td>
                                            <td><InputNumber @bind-Value="student.month3" class="form-control form-control-sm text-center" /></td>
                                            <td><InputNumber @bind-Value="student.month4" class="form-control form-control-sm text-center" /></td>
                                            <td><InputNumber @bind-Value="student.month5" class="form-control form-control-sm text-center" /></td>
                                            <td><InputNumber @bind-Value="student.month6" class="form-control form-control-sm text-center" /></td>
                                            <td class="fw-bold bg-light">@student.TotalScore.ToString("F2")</td>
                                            <td class="fw-bold bg-light">@student.Total.ToString("F2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-3 gap-3">
                            <div class="fs-5 text-muted">
                                นักเรียนทั้งหมด: <span class="badge bg-primary">@Students.Count คน</span>
                            </div>
                            <div>
                                <a href="ClassStudie/Timetable/@ClassId" class="btn btn-outline-secondary me-2">
                                    <i class="bi bi-arrow-left"></i> ย้อนกลับ
                                </a>
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-save"></i> บันทึกคะแนน
                                </button>
                            </div>
                        </div>
                    }
                </EditForm>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-header bg-light py-2">
                <h5 class="mb-0 text-primary"><i class="bi bi-info-circle-fill me-2"></i>คำแนะนำ</h5>
            </div>
            <div class="card-body fs-5">
                <ul class="list-group list-group-flush">
                    <li class="list-group-item"><i class="bi bi-pencil-fill text-primary me-2"></i>กรอกจำนวนชั่วโมงในแต่ละเดือน</li>
                    <li class="list-group-item"><i class="bi bi-calculator text-primary me-2"></i>ระบบจะคำนวณรวมให้อัตโนมัติ</li>
                    <li class="list-group-item"><i class="bi bi-check-circle-fill text-primary me-2"></i>กด "บันทึกคะแนน" เพื่อยืนยัน</li>
                </ul>
            </div>
        </div>

        <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
            <div id="saveToast" class="toast hide" role="alert" aria-live="assertive" aria-atomic="true">
                <div class="toast-header bg-success text-white">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <strong class="me-auto">สำเร็จ</strong>
                    <button type="button" class="btn-close" data-bs-dismiss="toast"></button>
                </div>
                <div class="toast-body">
                    บันทึกข้อมูลเรียบร้อยแล้ว
                </div>
            </div>
        </div>
    }
</div>


@code {
    [Parameter] public int? ClassId { get; set; }
    public int? SelectedClassId { get; set; }

    public List<ClassStudied> ClassList { get; set; } = new();
    public List<Students> Students { get; set; } = new();
    public List<string> Months { get; set; } = new();

    private bool IsProcessing { get; set; } = true;

    protected override async Task OnInitializedAsync()
    {
        ClassList = await _context.ClassStudieds.OrderByDescending(c => c.Id).ToListAsync();
        SelectedClassId = ClassId ?? ClassList.FirstOrDefault()?.Id;
        await LoadStudentsAsync();
        IsProcessing = false;
    }

    private async Task OnClassChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int value))
        {
            SelectedClassId = value;
            await LoadStudentsAsync();
        }
    }

    private async Task LoadStudentsAsync()
    {
        if (SelectedClassId == null) return;

        var selectedClass = await _context.ClassStudieds
            .FirstOrDefaultAsync(c => c.Id == SelectedClassId);

        if (selectedClass?.StartDate != null && selectedClass?.EndDate != null)
        {
            Months = selectedClass.GetStudyMonths(selectedClass.StartDate, selectedClass.EndDate);
        }
        else
        {
            Months = new List<string> { "เดือนที่ 1", "เดือนที่ 2", "เดือนที่ 3", "เดือนที่ 4", "เดือนที่ 5", "เดือนที่ 6" };
        }

        Students = await _context.students
            .Where(s => s.ClassStudie_Id == SelectedClassId)
            .OrderBy(s => s.FirstName)
            .ToListAsync();

    }

    private async Task SaveScores()
    {
        try
        {
            IsProcessing = true;
            foreach (var student in Students)
            {
                _context.students.Update(student);
            }

            await _context.SaveChangesAsync();
            IsProcessing = false;
            await _JSRuntime.InvokeVoidAsync("showToastr", "success", "บันทึกข้อมูลสำเร็จ");
        }
        catch (Exception ex)
        {
            IsProcessing = false;
            await _JSRuntime.InvokeVoidAsync("showToastr", "error", "เกิดข้อผิดพลาดในการบันทึก: " + ex.Message);
        }
    }
}