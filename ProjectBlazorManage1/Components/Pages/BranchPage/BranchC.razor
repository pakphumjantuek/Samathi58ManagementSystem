@page "/Branch"
@inject BranchService BranchService
@inject IJSRuntime JSRuntime


<Modals @ref="branchModal"
		Title="จัดการสาขา"
		IsVisible="showModal"
		OnConfirm="HandleValidSubmit"
		OnClose="CloseModal">

	<ChildContent>
		<EditForm id="modalForm" Model="@currentBranch" OnValidSubmit="@HandleValidSubmit">
			<DataAnnotationsValidator />
			<ValidationSummary />

			@if (currentBranch != null)

				@if (isEditMode == false)
				{
					<MudTextField T="int"
								  Label="รหัสสาขา"
								  Variant="Variant.Outlined"
								  @bind-Value="currentBranch.Branch_Id"
								  For="@(() => currentBranch.Branch_Id)"
								  RequiredError="กรุณากรอกรหัสสาขา" />
				}
				else
				{
					<MudTextField T="int"
								  Label="รหัสสาขา"
								  Variant="Variant.Outlined"
								  @bind-Value="currentBranch.Branch_Id"
								  For="@(() => currentBranch.Branch_Id)"
								  Disabled
								  RequiredError="กรุณากรอกรหัสสาขา" />
				}
			<MudTextField T="string"
						  Label="ชื่อสาขา"
						  Variant="Variant.Outlined"
						  @bind-Value="currentBranch.Branch_Name"
						  For="@(() => currentBranch.Branch_Name)"
						  RequiredError="กรุณากรอกชื่อสาขา" />
			<MudTextField T="string"
						  Label="เบอร์โทรศัพท์"
					      Variant="Variant.Outlined"
						  @bind-Value="currentBranch.Branch_Phone"
						  For="@(() => currentBranch.Branch_Phone)"
		                  MaxLength =10				  
						  RequiredError="กรุณากรอกเบอร์โทรศัพท์" />
			<MudTextField T="string"
						  Label="อีเมล"
						  Variant="Variant.Outlined"
						  @bind-Value="currentBranch.Branch_Email"
						  For="@(() => currentBranch.Branch_Email)"
						  RequiredError="อีเมล" />
		</EditForm>
	</ChildContent>
</Modals>

@if (IsProcessing)
{
	<div class="position-absolute w-75 h-75 d-flex flex-column align-items-center bg-white justify-content-center">
		<div class="spinner">
			<div class="rect1"></div>
			<div class="rect2"></div>
			<div class="rect3"></div>
			<div class="rect4"></div>
			<div class="rect5"></div>
		</div>
	</div>
}
else
{
	<div class="card shadow border-0 mt-4">
		<div class="card-header bg-dark bg-gradient ml-0 py-3">
			<div class="row">
				<div class="col-12 text-center">
					<h2 class="text-white py-2">ระบบจัดการข้อมูลสาขา</h2>
				</div>
			</div>
		</div>
		<div class="card-body p-4">
			<MudDataGrid T="Branch"
						 Items="@FilteredBranchList"
						 SortMode="SortMode.Multiple"
						 Filterable="true"
						 Hover="true"
						 Elevation="2"
						 Dense="true"
						 Bordered="true"
						 Striped="true"
						 RowClick="@(args => ShowEditModal(args.Item))"
						 Class="custom-datagrid">
				<ToolBarContent>
					<MudText Typo="Typo.h6" Color="Color.Primary" Class="font-weight-bold">ระบบจัดการข้อมูลสาขา</MudText>
					<MudSpacer />

					<div style="display: flex; align-items: center; gap: 12px;">
						<MudTextField @bind-Value="searchString"
									  Placeholder="ค้นหา..."
									  Variant="Variant.Outlined"
									  Size="Size.Small"
									  Adornment="Adornment.Start"
									  AdornmentIcon="@Icons.Material.Filled.Search"
									  Class="mr-2"
									  Immediate="true"
									  DebounceInterval="3000"
									  Style="width: 300px; font-size: 0.875rem;"
									  Margin="Margin.Dense" />

						<MudButton Variant="Variant.Filled"
								   Color="Color.Secondary"
								   StartIcon="@Icons.Material.Filled.Add"
								   OnClick="ShowAddModal"
								   Size="Size.Medium"
								   Class="add-button">
							เพิ่มข้อมูลสาขา
						</MudButton>
					</div>
				</ToolBarContent>

				<Columns>
					<PropertyColumn Property="x => x.Branch_Id"
									Title="รหัสสาขา"
									Filterable="true"
									Sortable="true"
									CellStyle="font-size: 14px;" />
					<PropertyColumn Property="x => x.Branch_Name"
									Title="ชื่อสาขา"
									Filterable="true"
									Sortable="true"
									CellStyle="font-size: 14px;" />
					<PropertyColumn Property="x => x.Branch_Phone"
									Title="เบอร์โทรศัพท์"
									Filterable="true"
									Sortable="true"
									CellStyle="font-size: 14px;" />
					<PropertyColumn Property="x => x.Branch_Email"
									Title="อีเมล"
									Filterable="true"
									Sortable="true"
									CellStyle="font-size: 14px;" />
					<TemplateColumn Title="สถานะ"
									CellClass="status-column"
									Sortable="false">
						<CellTemplate>
							<div @onclick:stopPropagation>
								<MudSwitch Value="@context.Item.Status"
										   ValueChanged="@(async (bool newValue) => await ToggleStatus(context.Item))"
										   ThumbIcon="@(context.Item.Status ? Icons.Material.Filled.Done : Icons.Material.Filled.Close)"
										   ThumbIconColor="@(context.Item.Status ? Color.Success : Color.Error)"
										   Disabled="@IsProcessing"
										   Class="custom-switch">

								</MudSwitch>
							</div>
						</CellTemplate>
					</TemplateColumn>
					<TemplateColumn Title="การจัดการ"
									CellClass="action-column"
									Sortable="false">
						<CellTemplate>
							<MudStack Row="true" Spacing="2">
								<MudButton Variant="Variant.Outlined"
										   Color="Color.Primary"
										   Size="Size.Small"
										   StartIcon="@Icons.Material.Filled.Edit"
										   OnClick="@(() => ShowEditModal(context.Item))">
									แก้ไข
								</MudButton>
								<MudButton Variant="Variant.Outlined"
										   Color="Color.Error"
										   Size="Size.Small"
										   StartIcon="@Icons.Material.Filled.Delete"
										   OnClick="@(() => Delete(context.Item.Branch_Id))">
									ลบ
								</MudButton>
							</MudStack>
						</CellTemplate>
					</TemplateColumn>
				</Columns>

				<PagerContent>
					<MudDataGridPager T="Branch" />
				</PagerContent>
			</MudDataGrid>
		</div>
	</div>

}


@code {
	private List<Branch> branchesList = new();
	private bool IsProcessing { get; set; } = true;

	private Modals branchModal;
	private bool showModal = false;
	private Branch currentBranch = new();
	private bool isEditMode = false;

	private string searchString = string.Empty;
	private IEnumerable<Branch> FilteredBranchList => branchesList
			.Where(x => string.IsNullOrWhiteSpace(searchString) ||
					x.Branch_Name.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
					x.Branch_Id.ToString().Contains(searchString))
					.OrderBy(p => p.Branch_Id);


	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await LoadBranch();
			IsProcessing = false;
			StateHasChanged();
		}
	}

	private async Task LoadBranch()
	{
		branchesList = await BranchService.GetBranches();
	}



	private void ShowAddModal()
	{
		currentBranch = new Branch();
		isEditMode = false;
		showModal = true;
		StateHasChanged();
	}

	private void CloseModal()
	{
		showModal = false;
		StateHasChanged();
	}

	private void ShowEditModal(Branch branch)
	{
		currentBranch = new Branch
			{
				Branch_Id = branch.Branch_Id,
				Branch_Name = branch.Branch_Name,
				Branch_Phone = branch.Branch_Phone,
				Branch_Email = branch.Branch_Email,
				Status = branch.Status
			};
		isEditMode = true;
		showModal = true;
		StateHasChanged();
	}

	private async Task ToggleStatus(Branch branch)
	{
		try
		{
			IsProcessing = true;
			StateHasChanged();
			branch.Status = !branch.Status;
			await BranchService.UpdateBranch(branch);
			await LoadBranch();
			if (branch.Status)
			{
				await JSRuntime.InvokeVoidAsync("showToastr", "success", "เปิดสถานะสำเร็จ");
			}
			else
			{
				await JSRuntime.InvokeVoidAsync("showToastr", "success", "ปิดสถานะสำเร็จ");
			}
		}
		catch (Exception ex)
		{
			Console.WriteLine($"Error toggling status: {ex.Message}");
			branch.Status = !branch.Status;
			await JSRuntime.InvokeVoidAsync("showToastr", "error", "เกิดข้อผิดพลาดในการเปลี่ยนสถานะ");
		}
		finally
		{
			IsProcessing = false;
			StateHasChanged();
		}
	}

	public async Task Delete(int id)
	{
		bool confirmDelete = await JSRuntime.InvokeAsync<bool>("ShowSwal", "success", "คุณแน่ใจที่จะลบสินค้าหรือไม่?");

		if (confirmDelete)
		{
			await BranchService.DeleteBranch(id);

			await JSRuntime.InvokeVoidAsync("showToastr", "success", "ลบสินค้าสำเร็จ");
		}
		await LoadBranch();
	}

	private async Task HandleValidSubmit()
	{
		try
		{
			IsProcessing = true;
			StateHasChanged();

			if (isEditMode)
			{
				await BranchService.UpdateBranch(currentBranch);
				await JSRuntime.InvokeAsync<bool>("ShowSwal", "test", "อัพเดทสาขาสำเร็จ");
			}
			else
			{
				await BranchService.AddBranch(currentBranch);
				await JSRuntime.InvokeAsync<bool>("ShowSwal", "test", "เพิ่มสาขาสำเร็จ");
			}

			await LoadBranch();
			showModal = false;
		}
		catch (Exception ex)
		{
			await JSRuntime.InvokeVoidAsync("showToastr", "error", $"เกิดข้อผิดพลาด: {ex.Message}");
		}
		finally
		{
			IsProcessing = false;
			StateHasChanged();
		}
	}



}
