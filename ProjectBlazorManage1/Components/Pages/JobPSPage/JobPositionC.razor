@page "/JobPosition"
@inject JobPositionService JobPositionService
@inject IJSRuntime JSRuntime

<Modals @ref="JobPSModal"
		Title="ระบบจัดการข้อมูลตำเเหน่งงาน"
		IsVisible="showModal"
		OnConfirm="HandleValidSubmit"
		OnClose="CloseModal">

	<ChildContent>
		<EditForm id="modalForm" Model="@currentJobPosition" OnValidSubmit="@HandleValidSubmit">
			<DataAnnotationsValidator />
			<ValidationSummary />

			@if (currentJobPosition != null)
			{
				<MudTextField T="string"
							  Label="ชื่อตำเเหน่ง"
							  							   Variant="Variant.Outlined"
							  @bind-Value="currentJobPosition.Position_Name"
							  For="@(() => currentJobPosition.Position_Name)"
							  RequiredError="กรุณากรอกชื่อตำเเหน่ง" />
				<MudTextField T="int"
							  Label="ลำดับขั้น"
							  							   Variant="Variant.Outlined"
							  @bind-Value="currentJobPosition.Position_Level"
							  For="@(() => currentJobPosition.Position_Level)"
							  RequiredError="กรุณากรอกลำดับขั้น" />
			}
		</EditForm>
	</ChildContent>
</Modals>

@if (IsProcessing)
{
	<div class="position-absolute w-75 h-75 d-flex flex-column align-items-center bg-white justify-content-center">
		<div class="spinner">
			<div class="rect1"></div>
			<div class="rect2"></div>
			<div class="rect3"></div>
			<div class="rect4"></div>
			<div class="rect5"></div>
		</div>
	</div>
}
else
{
	<div class="card shadow border-0 mt-4">
		<div class="card-header bg-black bg-gradient ml-0 py-3">
			<div class="row">
				<div class="col-12 text-center">
					<h2 class="text-white py-2">ระบบจัดการข้อมูลตำเเหน่งงาน</h2>
				</div>
			</div>
		</div>
		<div class="card-body p-4">
			<MudDataGrid T="JobPosition"
						 Items="@FilteredJobList.OrderBy(p => p.Position_Level)"
						 SortMode="SortMode.Multiple"
						 Filterable="true"
						 Hover="true"
						 Elevation="2"
						 Dense="true"
						 Bordered="true"
						 Striped="true"
						 RowClick="@(args => ShowEditModal(args.Item))"
						 Class="custom-datagrid mt-4">

				<ToolBarContent>
					<MudText Typo="Typo.h6" Color="Color.Primary" Class="font-weight-bold">ระบบจัดการข้อมูลตำแหน่งงาน</MudText>
					<MudSpacer />
					 <div style="display: flex; align-items: center; gap: 12px;">
					<MudTextField @bind-Value="searchString"
								  Placeholder="ค้นหา..."
								  Variant="Variant.Outlined"
								  Size="Size.Small"
								  Adornment="Adornment.Start"
								  AdornmentIcon="@Icons.Material.Filled.Search"
								  Class="mr-2"
								  Immediate="true"
								  DebounceInterval="3000"
								  Style="width: 300px; font-size: 0.875rem;"
								  Margin="Margin.Dense" />
					<MudButton Variant="Variant.Filled"
							   Color="Color.Secondary"
							   StartIcon="@Icons.Material.Filled.Add"
							   OnClick="ShowAddModal"
							   Size="Size.Medium"
							   Class="add-button">
						เพิ่มข้อมูลตำแหน่งงาน
					</MudButton>
					</div>
				</ToolBarContent>

				<Columns>
					<PropertyColumn Property="x => x.Position_Name"
									Title="ชื่อตำแหน่งงาน"
									Filterable="true"
									Sortable="true"
									CellStyle="font-size: 14px;" />

					<PropertyColumn Property="x => x.Position_Level"
									Title="ลำดับขั้น"
									Filterable="true"
									Sortable="true"
									CellStyle="font-size: 14px;" />

					<TemplateColumn Title="สถานะ"
									CellClass="status-column"
									Sortable="false">
						<CellTemplate>
							<div @onclick:stopPropagation>
								<MudSwitch Value="@context.Item.Status"
										   ValueChanged="@(async (bool newValue) => await ToggleStatus(context.Item))"
										   ThumbIcon="@(context.Item.Status ? Icons.Material.Filled.Done : Icons.Material.Filled.Close)"
										   ThumbIconColor="@(context.Item.Status ? Color.Success : Color.Error)"
										   Disabled="@IsProcessing"
										   Class="custom-switch">
								</MudSwitch>
							</div>
						</CellTemplate>
					</TemplateColumn>

					<TemplateColumn Title="การจัดการ"
									CellClass="action-column"
									Sortable="false">
						<CellTemplate>
							<MudStack Row="true" Spacing="2">
								<MudButton Variant="Variant.Outlined"
										   Color="Color.Primary"
										   Size="Size.Small"
										   StartIcon="@Icons.Material.Filled.Edit"
										   OnClick="@(() => ShowEditModal(context.Item))">
									แก้ไข
								</MudButton>
								<MudButton Variant="Variant.Outlined"
										   Color="Color.Error"
										   Size="Size.Small"
										   StartIcon="@Icons.Material.Filled.Delete"
										   OnClick="@(() => Delete(context.Item.Id))">
									ลบ
								</MudButton>
							</MudStack>
						</CellTemplate>
					</TemplateColumn>
				</Columns>

				<PagerContent>
					<MudDataGridPager T="JobPosition" />
				</PagerContent>

			</MudDataGrid>

		</div>
	</div>

}

@code {
	private List<JobPosition> jobPositionsList = new();
	private bool IsProcessing { get; set; } = true;

	private Modals JobPSModal;
	private bool showModal = false;
	private JobPosition currentJobPosition = new();
	private bool isEditMode = false;

	private string searchString = string.Empty;
	private IEnumerable<JobPosition> FilteredJobList => jobPositionsList
			.Where(x => string.IsNullOrWhiteSpace(searchString) ||
					x.Position_Name.Contains(searchString, StringComparison.OrdinalIgnoreCase))
					.OrderBy(p => p.Id);

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await LoadJobPS();
			IsProcessing = false;
			StateHasChanged();
		}
	}
	private async Task LoadJobPS()
	{
		jobPositionsList = await JobPositionService.GetJobPS();
	}

	private void ShowAddModal()
	{
		currentJobPosition = new JobPosition();
		isEditMode = false;
		showModal = true;
		StateHasChanged();
	}

	private void ShowEditModal(JobPosition jobPS)
	{
		currentJobPosition = new JobPosition
			{
				Id = jobPS.Id,
				Position_Name = jobPS.Position_Name,
				Position_Level = jobPS.Position_Level,
				Status = jobPS.Status
			};
		isEditMode = true;
		showModal = true;
		StateHasChanged();
	}

	private async Task ToggleStatus(JobPosition jobPS)
	{
		try
		{
			IsProcessing = true;
			StateHasChanged();
			jobPS.Status = !jobPS.Status;
			await JobPositionService.UpdateJobPs(jobPS);
			await LoadJobPS();
			if (jobPS.Status)
			{
				await JSRuntime.InvokeVoidAsync("showToastr", "success", "เปิดสถานะสำเร็จ");
			}
			else
			{
				await JSRuntime.InvokeVoidAsync("showToastr", "success", "ปิดสถานะสำเร็จ");
			}

		}
		catch (Exception ex)
		{

			Console.WriteLine($"Error toggling status: {ex.Message}");
			jobPS.Status = !jobPS.Status;
		}
		finally
		{
			IsProcessing = false;
			StateHasChanged();
		}
	}

	private void CloseModal()
	{
		showModal = false;
		StateHasChanged();
	}

	public async Task Delete(int id)
	{
		bool confirmDelete = await JSRuntime.InvokeAsync<bool>("ShowSwal", "success", "คุณแน่ใจที่จะลบหรือไม่?");

		if (confirmDelete)
		{
			await JobPositionService.DeleteJobPs(id);

			await JSRuntime.InvokeVoidAsync("showToastr", "success", "ลบสินค้าสำเร็จ");
		}
		await LoadJobPS();
	}

	private async Task HandleValidSubmit()
	{
		try
		{
			IsProcessing = true;
			StateHasChanged();

			if (isEditMode)
			{
				await JobPositionService.UpdateJobPs(currentJobPosition);
				await JSRuntime.InvokeAsync<bool>("ShowSwal", "test", "อัพเดทตำเเหน่งงานสำเร็จ");
			}
			else
			{
				await JobPositionService.AddJobPs(currentJobPosition);
				await JSRuntime.InvokeAsync<bool>("ShowSwal", "test", "เพิ่มตำเเหน่งงานสำเร็จ");
			}

			await LoadJobPS();
			showModal = false;
		}
		catch (Exception ex)
		{
			await JSRuntime.InvokeVoidAsync("showToastr", "error", $"เกิดข้อผิดพลาด: {ex.Message}");
		}
		finally
		{
			IsProcessing = false;
			StateHasChanged();
		}
	}


}
