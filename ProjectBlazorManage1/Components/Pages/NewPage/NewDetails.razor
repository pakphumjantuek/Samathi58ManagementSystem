@page "/News/NewsDetails/{New_Id:int}"
@inject NewsService NewsService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime 


<PageTitle>@(news?.Title ?? "กำลังโหลดข้อมูล...")</PageTitle>

@if (news == null)
{
    <div class="container my-5 py-5">
        <div class="text-center">
            <div class="spinner-grow text-success" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">กำลังโหลดข้อมูล...</span>
            </div>
            <h4 class="mt-4 text-muted">กำลังโหลดข้อมูลข่าว...</h4>
        </div>
    </div>
}
else
{
    <div class="container py-5">
        <!-- ปุ่มกลับด้านบน -->
        <div class="mb-4">
            <button class="btn btn-outline-secondary rounded-pill px-4" @onclick="GoBack">
                <i class="bi bi-arrow-left me-2"></i> กลับสู่รายการข่าว
            </button>
        </div>

        <div class="row">
            <div class="col-lg-10 offset-lg-1">
                <article class="news-detail bg-white rounded-4 shadow-sm p-4 p-md-5">
                    <!-- ส่วนหัวข่าว -->
                    <header class="mb-4">
                        <!-- สถานะข่าว -->
                        <div class="mb-3">
                            <span class="badge @(news.Status ? "bg-success" : "bg-secondary") rounded-pill px-3 py-2 fs-6">
                                @(news.Status ? "เผยแพร่" : "ฉบับร่าง")
                            </span>
                        </div>

                        <!-- หัวข้อข่าว -->
                        <h1 class="display-5 fw-bold mb-4 text-success">@news.Title</h1>

                        <!-- ข้อมูลวันที่ -->
                        <div class="d-flex align-items-center mb-4">
                            <div class="rounded-circle bg-light p-2 d-flex align-items-center justify-content-center" style="width: 45px; height: 45px;">
                                <i class="bi bi-calendar-event text-success fs-4"></i>
                            </div>
                            <div class="ms-3">
                                <p class="mb-0 fs-5">@news.DateStart.ToString("dd MMMM yyyy", new System.Globalization.CultureInfo("th-TH"))</p>
                            </div>
                        </div>

                        <!-- รูปภาพหลัก (สไลด์) -->
                        @if (!string.IsNullOrEmpty(news.Images))
                        {
                            var images = GetImages();
                            <div id="newsCarousel" class="carousel slide mb-5 shadow-sm rounded-4 overflow-hidden" data-bs-ride="carousel">
                                <!-- ตัวบ่งชี้ (Indicators) -->
                                @if (images.Count > 1)
                                {
                                    <div class="carousel-indicators">
                                        @for (int i = 0; i < images.Count(); i++)
                                        {
                                            <button type="button"
                                                    data-bs-target="#newsCarousel"
                                                    data-bs-slide-to="@i"
                                                    class="@(i == 0 ? "active" : "")"
                                                    aria-current="@(i == 0 ? "true" : "false")"
                                                    aria-label="Slide @(i+1)"></button>
                                        }
                                    </div>
                                }
                                <!-- รูปภาพในสไลด์ -->
                                <div class="carousel-inner">
                                    @for (int i = 0; i < images.Count(); i++)
                                    {
                                        <div class="carousel-item @(i == 0 ? "active" : "")">
                                            <img src="@images[i]"
                                                 class="d-block w-100"
                                                 style="max-height: 550px; object-fit: contain;"
                                                 alt="ภาพข่าว @(i + 1)" />
                                        </div>
                                    }
                                </div>


                            </div>
                        }

                     
                        <!-- เนื้อหาข่าว -->
                        <div class="content-section mb-5">
                            <div class="section-title d-flex align-items-center mb-4">
                                <div class="icon-box bg-success text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="bi bi-file-text fs-5"></i>
                                </div>
                                <h2 class="fs-3 fw-bold ms-3 mb-0">เนื้อหาข่าวประชาสัมพันธ์</h2>
                            </div>
                            <div class="news-content fs-5 lh-lg pb-3" style="border-bottom: 1px solid #e0e0e0;">
                                @((MarkupString)news.News_Content?.Replace("\n", "<br>"))
                            </div>
                        </div>

                        <!-- รูปภาพเพิ่มเติม -->
                         @if (GetImages().Count > 1)
                        {
                            <div class="additional-images mb-5">
                                <div class="section-title d-flex align-items-center mb-4">
                                    <div class="icon-box bg-success text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                        <i class="bi bi-images fs-5"></i>
                                    </div>
                                    <h2 class="fs-3 fw-bold ms-3 mb-0">รูปภาพเพิ่มเติม</h2>
                                </div>

                                <div class="row g-4 image-gallery">
                                    @foreach (var imageUrl in GetImages().Skip(1))
                                    {
                                        <div class="col-md-4 col-sm-6">
                                            <div class="image-card shadow-sm rounded-4 overflow-hidden hover-zoom position-relative">
                                                <img src="@imageUrl"
                                                     class="img-fluid w-100"
                                                     style="height: 220px; object-fit: cover; cursor: pointer;"
                                                     alt="รูปภาพเพิ่มเติม"
                                                     @onclick="() => ShowImageModal(imageUrl)" />
                                                <!-- Fullscreen icon overlay -->
                                                <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-dark bg-opacity-25 opacity-0 hover-opacity-100 transition-opacity"
                                                     style="cursor: pointer;"
                                                     @onclick="() => ShowImageModal(imageUrl)">
                                                    <i class="bi bi-arrows-fullscreen text-white fs-3"></i>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        <!-- วิดีโอ YouTube -->
                        @if (!string.IsNullOrEmpty(news.YouTubeUrl))
                        {
                            <div class="youtube-embed mb-5">
                                <div class="section-title d-flex align-items-center mb-4">
                                    <div class="icon-box bg-danger text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                        <i class="bi bi-youtube fs-5"></i>
                                    </div>
                                    <h2 class="fs-3 fw-bold ms-3 mb-0">วิดีโอที่เกี่ยวข้อง</h2>
                                </div>

                                <div class="ratio ratio-16x9 shadow-sm rounded-4 overflow-hidden">
                                    <iframe src="@GetEmbedYoutubeUrl(news.YouTubeUrl)"
                                            title="YouTube video"
                                            allowfullscreen>
                                    </iframe>
                                </div>
                            </div>
                        }

                        <!-- ปุ่มแชร์ -->
                        <div class="social-share mb-5">
                            <div class="section-title d-flex align-items-center mb-4">
                                <div class="icon-box bg-info text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                    <i class="bi bi-share fs-5"></i>
                                </div>
                                <h2 class="fs-3 fw-bold ms-3 mb-0">แชร์ข่าวนี้</h2>
                            </div>

                            <div class="d-flex flex-wrap gap-2">
                                <button type="button" class="btn btn-primary rounded-pill px-4 py-2" @onclick="ShareToFacebook">
                                    <i class="bi bi-facebook me-2"></i> Facebook
                                </button>

                                <button type="button" class="btn btn-success rounded-pill px-4 py-2" @onclick="ShareToLine">
                                    <i class="bi bi-line me-2"></i> Line
                                </button>

                                <button type="button" class="btn btn-secondary rounded-pill px-4 py-2" @onclick="CopyLink">
                                    <i class="bi bi-link-45deg me-2"></i> คัดลอกลิงก์
                                </button>
                            </div>
                        </div>
                    </header>
                </article>

                <!-- ข่าวที่เกี่ยวข้อง -->
                @if (relatedNews != null && relatedNews.Any())
                {
                    <div class="related-news mt-5">
                        <div class="section-title d-flex align-items-center mb-4">
                            <div class="icon-box bg-success text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                                <i class="bi bi-newspaper fs-5"></i>
                            </div>
                            <h2 class="fs-3 fw-bold ms-3 mb-0">ข่าวล่าสุด</h2>
                        </div>

                        <div class="row g-4">
                            @foreach (var item in relatedNews)
                            {
                                var firstImage = string.IsNullOrEmpty(item.Images)
                                ? null
                                : item.Images.Split(';').FirstOrDefault()?.Trim();

                                <div class="col-lg-4 col-md-6">
                                    <div class="card h-100 border-0 shadow-sm rounded-4 hover-card overflow-hidden">
                                        <div class="position-relative news-image-container">
                                            @if (!string.IsNullOrEmpty(firstImage))
                                            {
                                                <img src="@firstImage"
                                                     class="img-fluid w-100"
                                                     style="height: 200px; object-fit: cover;" />
                                            }
                                            else
                                            {
                                                <div class="bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                                    <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                                                </div>
                                            }

                                           
                                        </div>

                                        <div class="card-body d-flex flex-column p-4">
                                            <h5 class="card-title fw-bold mb-3 text-truncate-2">@item.Title</h5>
                                            <div class="mt-auto text-end">
                                                <button class="btn btn-success px-4 rounded-pill" @onclick="() => GoToNews(item.News_Id)">
                                                    <i class="bi bi-book me-2"></i>อ่านเพิ่มเติม
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- ปุ่มกลับด้านล่าง -->
                <div class="text-center mt-5">
                    <button class="btn btn-lg btn-outline-secondary rounded-pill px-5 py-2" @onclick="GoBack">
                        <i class="bi bi-arrow-left me-2"></i> กลับสู่รายการข่าวทั้งหมด
                    </button>
                </div>
            </div>
        </div>
    </div>
}

    @if (isImageModalVisible)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.8);" @onclick="CloseImageModal">
            <div class="modal-dialog modal-dialog-centered modal-lg" @onclick:stopPropagation>
                <div class="modal-content bg-transparent border-0 shadow-lg">
                    <div class="modal-body text-center position-relative p-0">
                        <img src="@selectedImageUrl"
                             class="img-fluid rounded"
                             style="max-height: 80vh;" />
                        <button class="btn-close btn-close-white position-absolute top-0 end-0 m-3"
                                aria-label="Close"
                                @onclick="CloseImageModal"></button>
                    </div>
                </div>
            </div>
        </div>
        <div class="modal-backdrop fade show"></div>
    }
}




@code {
    [Parameter]
    public int New_Id { get; set; }

    private News news;
    private List<News> relatedNews = new();
    private bool isImageModalVisible = false;
    private string selectedImageUrl = string.Empty;
    private string BaseUrl => NavigationManager.BaseUri.TrimEnd('/');

    private void ShowImageModal(string imageUrl)
    {
        selectedImageUrl = imageUrl;
        isImageModalVisible = true;
    }

    private void CloseImageModal()
    {
        isImageModalVisible = false;
        selectedImageUrl = string.Empty;
    }

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            news = await NewsService.FindIdNews(New_Id);

            if (news == null)
            {
                NavigationManager.NavigateTo("/NewsPage");
                return;
            }

            relatedNews = await NewsService.GetAllNews();
            relatedNews = relatedNews
                .Where(x => x.News_Id != New_Id)
                .OrderByDescending(x => x.DateStart)
                .Take(3)
                .ToList();
        }
        catch (Exception)
        {
            NavigationManager.NavigateTo("NewsPage");
        }
    }

    private List<string> GetImages()
    {
        if (string.IsNullOrEmpty(news?.Images))
            return new List<string>();

        var imageNames = news.Images.Split(';', StringSplitOptions.RemoveEmptyEntries)
                                    .Select(img => img.Trim())
                                    .ToList();

        // Generate URLs from the image names
        var imageUrls = imageNames.Select(img =>
        {
            var fileName = Path.GetFileName(img);
            return $"{BaseUrl}/images/News/{fileName}";
        }).ToList();
 
        return imageUrls;
    }

    private string GetEmbedYoutubeUrl(string youtubeUrl)
    {
        if (string.IsNullOrEmpty(youtubeUrl)) return string.Empty;

        return youtubeUrl.Replace("watch?v=", "embed/");
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("NewsPage");
    }

    private void GoToNews(int id)
    {
        NavigationManager.NavigateTo($"News/NewsDetails/{id}");
    }

    private async Task ShareToFacebook()
    {
        var url = NavigationManager.Uri;
        var shareUrl = $"https://www.facebook.com/sharer/sharer.php?u={Uri.EscapeDataString(url)}";
        await JSRuntime.InvokeVoidAsync("open", shareUrl, "_blank");
    }

    private async Task ShareToLine()
    {
        var url = NavigationManager.Uri;
        var shareUrl = $"https://social-plugins.line.me/lineit/share?url={Uri.EscapeDataString(url)}";
        await JSRuntime.InvokeVoidAsync("open", shareUrl, "_blank");
    }

    private async Task CopyLink()
    {
        var url = NavigationManager.Uri;
        await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", url);
        await JSRuntime.InvokeVoidAsync("alert", "คัดลอกลิงก์แล้ว!");
    }
}
