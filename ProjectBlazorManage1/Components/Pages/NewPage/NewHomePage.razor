@page "/NewsPage"

@inject NewsService NewsService
@inject NavigationManager NavigationManager

<PageTitle>ข่าวประชาสัมพันธ์</PageTitle>
<div class="container my-5">
    <!-- Header Section with Hero Banner -->
    <div class="bg-light rounded-4 shadow-sm p-4 mb-5">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="display-5 fw-bold text-success mb-3">ข่าวประชาสัมพันธ์</h1>
                <p class="lead text-muted">อัพเดทข่าวสารและกิจกรรมล่าสุดจากเรา</p>
            </div>
            <div class="col-lg-4 text-end d-none d-lg-block">
                <i class="bi bi-newspaper text-success" style="font-size: 5rem;"></i>
            </div>
        </div>
    </div>

    <!-- Loading State -->
    @if (isLoading)
    {
        <div class="position-absolute w-75 h-75 d-flex flex-column align-items-center bg-white justify-content-center">
            <div class="spinner">
                <div class="rect1"></div>
                <div class="rect2"></div>
                <div class="rect3"></div>
                <div class="rect4"></div>
                <div class="rect5"></div>
            </div>
        </div>
    }
    else
    {
    <MudGrid Class="pa-4" GutterSize="GutterSize.Small">
    <!-- Search Bar -->
    <MudItem xs="12" sm="12" md="8" Class="px-0 py-0 py-sm-0 pr-sm-2">
        <MudTextField @bind-Value="@searchQuery"
                      Immediate="true"
                      Placeholder="🔍 ค้นหาข่าว..."
                      Variant="Variant.Outlined"
                      Margin="Margin.None"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      AdornmentColor="Color.Primary"
                      IconSize="Size.Medium"
                      Class="news-search-input"
                      Style="@("width: 100%; " +
                            "background-color: white; " +
                            "border-radius: 8px; " +
                            "height: 56px; " +
                            "box-shadow: 0 2px 8px rgba(0,0,0,0.1);")"
                      InputStyle="font-size: 1rem; padding: 16px;">
            <LabelStyle>
                <LabelStyle Style="color: #5f6368; font-weight: 500; font-size: 0.875rem; padding-bottom: 8px;">ค้นหาข่าวสาร</LabelStyle>
            </LabelStyle>
        </MudTextField>
    </MudItem>

    <!-- Date Picker -->
    <MudItem xs="12" sm="12" md="4" Class="px-0 py-0 py-sm-0 pl-sm-2">
        <MudDatePicker @bind-Date="selectedDate"
                       PickerVariant="PickerVariant.Dialog"
                       Placeholder="📅 เลือกวัน/เดือน/ปี"
                       DateFormat="dd MMMM yyyy"
                       Clearable="true"
                       DisableToolbar="false"
                       AutoClose="true"
                       Variant="Variant.Outlined"
                       Margin="Margin.None"
                       Adornment="Adornment.End"
                       AdornmentIcon="@Icons.Material.Filled.Event"
                       AdornmentColor="Color.Primary"
                       IconSize="Size.Medium"
                       Class="news-date-picker"
                       Style="@("width: 100%; " +
                             "background-color: white; " +
                             "border-radius: 8px; " +
                             "box-shadow: 0 2px 8px rgba(0,0,0,0.1);")">
            <LabelStyle>
                <LabelStyle Style="color: #5f6368; font-weight: 500; font-size: 0.875rem; padding-bottom: 8px;">กรองตามวันที่</LabelStyle>
            </LabelStyle>
        </MudDatePicker>
    </MudItem>
</MudGrid>

          <div >
        <div class="d-flex flex-wrap justify-content-between align-items-center">
            <p class="mb-0 text-muted">แสดงข่าวทั้งหมด <span class="fw-bold">@allNews.Count</span> รายการ</p>
        </div>
    </div>


        <!-- ส่วนนี้คือการตรวจสอบว่าไม่พบข้อมูล -->
        @if (pagedNewsList.Count == 0)
        {
            <div class="alert alert-warning text-center" role="alert" style="background-color: #fff3cd; border: 2px solid #ffeeba; border-radius: 8px; padding: 20px; box-shadow: 0 4px 8px rgba(0,0,0,0.1); margin: 20px 0; font-family: 'Sarabun', sans-serif;">
                <div style="display: flex; align-items: center; justify-content: center; margin-bottom: 10px;">
                    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="#856404" viewBox="0 0 16 16" style="margin-right: 10px;">
                        <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm.93-9.412-1 4.705c-.07.34.029.533.304.533.194 0 .487-.07.686-.246l-.088.416c-.287.346-.92.598-1.465.598-.703 0-1.002-.422-.808-1.319l.738-3.468c.064-.293.006-.399-.287-.47l-.451-.081.082-.381 2.29-.287zM8 5.5a1 1 0 1 1 0-2 1 1 0 0 1 0 2z" />
                    </svg>
                    <h5 style="color: #856404; margin: 0; font-weight: 600; font-size: 1.25rem;">แจ้งให้ทราบ</h5>
                </div>

                @if (!string.IsNullOrWhiteSpace(searchQuery) && selectedDate.HasValue)
                {
                    <p style="color: #856404; font-size: 1.1rem; margin: 0;">ไม่พบข่าวที่ค้นหาหรือวันที่ที่เลือก</p>
                }
                else if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <p style="color: #856404; font-size: 1.1rem; margin: 0;">ไม่พบข่าวที่ค้นหา: "<span style="font-weight: bold;">@searchQuery</span>"</p>
                }
                else if (selectedDate.HasValue)
                {
                    <p style="color: #856404; font-size: 1.1rem; margin: 0;">ไม่พบข่าวในวันที่: <span style="font-weight: bold;">@selectedDate.Value.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("th-TH"))</span></p>
                }
                else
                {
                    <p style="color: #856404; font-size: 1.1rem; margin: 0;">ไม่พบข่าวที่จะแสดง</p>
                }

                <div style="margin-top: 15px;">
                    <button class="btn btn-sm" style="background-color: #f8d7da; border: 1px solid #f5c6cb; color: #721c24; padding: 5px 15px; border-radius: 4px; font-weight: 500; cursor: pointer;">กลับไปหน้าหลัก</button>
                </div>
            </div>
        }
        else
        {
            <!-- News Cards Section -->
            <div class="row g-4">
                @foreach (var news in pagedNewsList)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="card h-100 border-0 shadow-sm hover-card overflow-hidden">
                            <div class="position-relative news-image-container">
                                @if (GetImages(news).Any())
                                {
                                    var firstImage = GetImages(news).FirstOrDefault();

                                    if (!string.IsNullOrEmpty(firstImage))
                                    {
                                        <img src="@firstImage"
                                             class="card-img-top"
                                             style="height: 220px; object-fit: cover; transition: transform 0.3s ease;"
                                             alt="ข่าว @news.Title" />
                                    }
                                }
                                else
                                {
                                    <div class="bg-light d-flex align-items-center justify-content-center" style="height: 220px;">
                                        <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
                                    </div>
                                }
                                <div class="news-date-badge">
                                    <span class="date-day">@news.DateStart.Day</span>
                                    <span class="date-month">@news.DateStart.ToString("MMM", new System.Globalization.CultureInfo("th-TH"))</span>
                                </div>
                            </div>

                            <div class="card-body d-flex flex-column p-4">
                                <h5 class="card-title fw-bold mb-3 text-truncate-2">@news.Title</h5>
                                <div class="text-muted mb-3 d-flex align-items-center small">
                                    <i class="bi bi-calendar-event me-2"></i>
                                    @news.DateStart.ToString("d MMMM yyyy", new System.Globalization.CultureInfo("th-TH"))
                                </div>
                                <div class="card-text mb-4 news-content-preview">
                                    @((MarkupString)news.News_Content)
                                </div>
                                <div class="mt-auto text-end">
                                    <button class="btn btn-success px-4 rounded-pill" @onclick="() => GoToDetails(news.News_Id)">
                                        <i class="bi bi-book me-2"></i>อ่านเพิ่มเติม
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

    <!-- Enhanced Pagination -->
    @if (totalPages > 1)
    {
        <nav class="mt-5">
            <ul class="pagination pagination-lg justify-content-center flex-wrap gap-1">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a href="javascript:void(0);" class="page-link rounded-pill shadow-sm border-0 text-success px-3 py-2"
                       @onclick="PreviousPage" @onclick:preventDefault>
                        <i class="bi bi-chevron-left"></i>
                    </a>
                </li>

                @{
                    int startPage = Math.Max(1, currentPage - 2);
                    int endPage = Math.Min(totalPages, startPage + 4);

                    if (endPage - startPage < 4 && totalPages > 5)
                    {
                        startPage = Math.Max(1, endPage - 4);
                    }

                    if (startPage > 1)
                    {
                        <li class="page-item">
                            <a href="javascript:void(0);" class="page-link rounded-pill border-0 shadow-sm px-3 py-2"
                               @onclick="() => ChangePage(1)" @onclick:preventDefault>1</a>
                        </li>
                        if (startPage > 2)
                        {
                            <li class="page-item disabled">
                                <span class="page-link border-0 bg-transparent shadow-none">...</span>
                            </li>
                        }
                    }

                    for (int i = startPage; i <= endPage; i++)
                    {
                        var pageNumber = i;
                        <li class="page-item @(currentPage == pageNumber ? "active" : "")">
                            <a href="javascript:void(0);"
                               class="page-link rounded-pill border-0 shadow-sm px-3 py-2 @(currentPage == pageNumber ? "bg-success text-white" : "text-success")"
                               @onclick="() => ChangePage(pageNumber)"
                            @onclick:preventDefault>@pageNumber</a>
                        </li>
                    }

                    if (endPage < totalPages)
                    {
                        if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled">
                                <span class="page-link border-0 bg-transparent shadow-none">...</span>
                            </li>
                        }
                        <li class="page-item">
                            <a href="javascript:void(0);" class="page-link rounded-pill border-0 shadow-sm px-3 py-2"
                               @onclick="() => ChangePage(totalPages)" @onclick:preventDefault>@totalPages</a>
                        </li>
                    }
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a href="javascript:void(0);" class="page-link rounded-pill shadow-sm border-0 text-success px-3 py-2"
                       @onclick="NextPage" @onclick:preventDefault>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>
            </ul>
        </nav>
    }

}
</div>



@code {
    private List<News> allNews = new();
    private News news;
    private List<News> pagedNewsList = new();
    private int currentPage = 1;
    private int pageSize = 6;
    private int totalPages = 1;
    private bool isLoading = true;

    private string _searchQuery = string.Empty;
    private DateTime? _selectedDate;
    private Timer? debounceTimer;

    private DateTime? selectedDate
    {
        get => _selectedDate;
        set
        {
            _selectedDate = value;
            ApplyFilters(); // กรองทุกครั้งที่มีการเลือกวัน
        }
    }
    private string searchQuery
    {
        get => _searchQuery;
        set
        {
            _searchQuery = value;

            debounceTimer?.Dispose();
            debounceTimer = new Timer(_ =>
            {
                InvokeAsync(() =>
                {
                    ApplyFilters();
                    StateHasChanged();
                });
            }, null, 350, Timeout.Infinite); // 250ms debounce
        }
    }
    private string BaseUrl => NavigationManager.BaseUri.TrimEnd('/');

   
    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        allNews = await NewsService.GetAllNews() ?? new List<News>();

        if (allNews.Any())
        {
            allNews = allNews.OrderByDescending(n => n.DateStart).ToList();
            totalPages = (int)Math.Ceiling(allNews.Count / (double)pageSize);
            LoadCurrentPage();
        }
        else
        {
            pagedNewsList = new List<News>();
            totalPages = 1;
        }

        isLoading = false;
    }

   private List<string> GetImages(News newsItem)
{
    if (string.IsNullOrEmpty(newsItem?.Images))
        return new List<string>();

    var imageNames = newsItem.Images.Split(';', StringSplitOptions.RemoveEmptyEntries)
                                    .Select(img => img.Trim())
                                    .ToList();

    var imageUrls = imageNames.Select(img =>
    {
        var fileName = Path.GetFileName(img);
        return $"{BaseUrl}/images/News/{fileName}";
    }).ToList();

    return imageUrls;
}


    private void ApplyFilters(ChangeEventArgs? e = null)
    {
        currentPage = 1;
        LoadCurrentPage();
    }

    private void LoadCurrentPage()
    {
        IEnumerable<News> filtered = allNews;

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            filtered = filtered.Where(n =>
                n.Title.Trim().Contains(searchQuery.Trim(), StringComparison.OrdinalIgnoreCase) ||
                n.News_Content.Trim().Contains(searchQuery.Trim(), StringComparison.OrdinalIgnoreCase));
        }

        if (selectedDate.HasValue)
        {
            // กรองเฉพาะข่าวที่ตรงกับวันเดียวกัน
            filtered = filtered.Where(n =>
                n.DateStart.Date == selectedDate.Value.Date);
        }

        var filteredList = filtered.OrderByDescending(n => n.DateStart).ToList();

        totalPages = (int)Math.Ceiling(filteredList.Count / (double)pageSize);

        pagedNewsList = filteredList
            .Skip((currentPage - 1) * pageSize)
            .Take(pageSize)
            .ToList();

        StateHasChanged();
    }

    private void ChangePage(int page)
    {
        if (page >= 1 && page <= totalPages)
        {
            currentPage = page;
            LoadCurrentPage();
        }
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            LoadCurrentPage();
        }
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            LoadCurrentPage();
        }
    }

    private void GoToDetails(int newsId)
    {
        NavigationManager.NavigateTo($"News/NewsDetails/{newsId}");
    }
}


